# Relay 开发/启动环境变量（复制为 .env 并按需修改）
RELAY_PORT=8322
RELAY_DATA_DIR=./data
RELAY_PUBLIC_DIR=./public
RELAY_ADMIN_USERNAME=admin
# 至少 8 位
RELAY_ADMIN_PASSWORD=Admin@123
# 64 位 hex（32 字节）；首次可删掉下面两行，启动时会自动生成并打印，请替换保存
RELAY_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# 仅开发时可设 1 禁用验证码
RELAY_DISABLE_CAPTCHA=1
